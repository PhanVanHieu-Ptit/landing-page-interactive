{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/animation/**", "src/content/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "@/components/*",
                  "@/hooks/*",
                  "@/sections/*"
                ],
                "message": "src/animation and src/content stay framework-agnostic: no React and no UI imports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/image-sequence/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react/*", "react-dom", "react-dom/*", "@/**"],
                "message": "src/image-sequence/core is the engine's framework-free layer: no React and nothing from the app."
              }
            ]
          }
        ]
      }
    }
  ]
}
